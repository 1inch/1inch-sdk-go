{
  "openapi": "3.0.0",
  "info": {
    "title": "Package naming fixture API",
    "description": "A spec file whose name contains an underscore; the generator must strip the suffix for the package name but keep it in the output file name. Used by codegen_test.go.",
    "version": "1.0.0"
  },
  "paths": {
    "/extra": {
      "get": {
        "operationId": "getExtraThing",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtraThing"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtraThing": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
